generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING_VALIDATION
  CONFIRMED
  REJECTED
  CANCELLED
}

model Appointment {
  id                   String        @id @default(cuid())
  serviceId            String
  serviceName          String
  servicePrice         Int
  depositAmount        Int
  clientName           String
  clientPhone          String
  clientEmail          String?
  paymentReference     String
  inspirationImagePath String?
  notes                String?
  adminNotes           String?
  startAt              DateTime
  endAt                DateTime
  status               BookingStatus @default(PENDING_VALIDATION)
  googleEventId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([startAt, status])
  @@index([paymentReference])
}